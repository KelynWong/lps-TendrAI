# ---- TendrAI API — environment -------------------------------------------
# On EC2 these come from the instance's environment file (written by
# infra/modules/tendrai/ec2.tf user_data): DB_HOST, DB_PORT, DB_NAME,
# DB_SECRET_ARN (the tendrai_app role secret, read at start-up),
# DOCUMENTS_BUCKET, JOB_QUEUE_URL, AWS_REGION. No secret values are set here.

PORT=8080
LOG_LEVEL=info
AWS_REGION=ap-southeast-1

# Database: either DATABASE_URL or the parts below
# DATABASE_URL=postgres://tendradmin:password@localhost:5432/tendrai
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tendrai
# Local only: credentials JSON. On EC2 use DB_SECRET_ARN instead.
DB_CREDENTIALS={"username":"tendradmin","password":"change-me"}
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-southeast-1:123456789012:secret:tendrai-prod-db-app-...
# Path to the RDS CA bundle; empty = no TLS verification (local dev only)
DB_SSL_CA_PATH=

# Storage / queue
DOCUMENTS_BUCKET=tendrai-dev-documents-123456789012
JOB_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/tendrai-dev-tender-jobs
# Optional: second-copy bucket shown on the Backup page
BACKUP_BUCKET=
BACKUP_BUCKET_REGION=ap-southeast-2

# Auth: alb (x-amzn-oidc-data from the ALB Cognito action), cognito (Bearer
# token), or dev (x-dev-user: <email> header, users must exist in the table)
AUTH_MODE=dev
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# alb/cognito modes: the pool's public signing keys, bundled with the release
# (npm run fetch:jwks); the API never downloads them
COGNITO_JWKS_PATH=certs/cognito-jwks.json

# Browser origin allowed to call the API (Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Presigned URL lifetime in seconds
PRESIGN_TTL_SECONDS=900
