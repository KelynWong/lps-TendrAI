# ---------------------------------------------------------------------------
# TendrAI — Secrets Manager (diagram item 6)
#
# * App config secret: placeholder JSON the operators fill in after deploy
#   (API keys, app-level settings...). The version below is created once and
#   subsequent value changes made outside Terraform are ignored.
# * DB master secret: created and rotated BY RDS via
#   manage_master_user_password (see rds.tf). Used only by operators for
#   migrations and the role bootstrap; no app or Lambda role can read it.
# * DB role secrets: one per least-privilege login role (db/roles.sql), read
#   only by its own consumer. The password is generated by an ephemeral
#   resource and written write-only, so it never appears in Terraform state or
#   plan output. Operators then set it on the role in Postgres with
#   `npm --prefix api run db:roles` (docs/runbooks/db-roles.md).
#   Rotate: bump var.db_role_password_version, apply, re-run db:roles.
# ---------------------------------------------------------------------------

locals {
  # secret key => Postgres login role (must match db/roles.sql)
  db_roles = {
    app            = "tendrai_app"
    status_updater = "tendrai_status_updater"
    result_loader  = "tendrai_result_loader"
  }
}

resource "aws_secretsmanager_secret" "db_role" {
  for_each = local.db_roles

  name_prefix = "${local.name}-db-${replace(each.key, "_", "-")}-"
  description = "Credentials of the ${each.value} Postgres role ({\"username\",\"password\"})"
  kms_key_id  = aws_kms_key.data.arn

  recovery_window_in_days = 7

  tags = {
    Name = "${local.name}-db-${replace(each.key, "_", "-")}"
  }
}

ephemeral "aws_secretsmanager_random_password" "db_role" {
  for_each = local.db_roles

  password_length     = 40
  exclude_punctuation = true
}

resource "aws_secretsmanager_secret_version" "db_role" {
  for_each = local.db_roles

  secret_id = aws_secretsmanager_secret.db_role[each.key].id
  secret_string_wo = jsonencode({
    username = each.value
    password = ephemeral.aws_secretsmanager_random_password.db_role[each.key].random_password
  })
  secret_string_wo_version = var.db_role_password_version
}

resource "aws_secretsmanager_secret" "app_config" {
  name_prefix = "${local.name}-app-config-"
  description = "TendrAI application configuration (placeholder — populate real values out-of-band)"
  kms_key_id  = aws_kms_key.data.arn

  recovery_window_in_days = 7

  tags = {
    Name = "${local.name}-app-config"
  }
}

resource "aws_secretsmanager_secret_version" "app_config" {
  secret_id = aws_secretsmanager_secret.app_config.id

  secret_string = jsonencode({
    placeholder            = "replace-me"
    bedrock_embed_model_id = var.bedrock_embed_model_id
    bedrock_text_model_id  = var.bedrock_text_model_id
  })

  lifecycle {
    # Operators manage the real values in the console/CLI; don't fight them.
    ignore_changes = [secret_string]
  }
}
