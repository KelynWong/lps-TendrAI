# ---------------------------------------------------------------------------
# Points Terraform at the Floci emulator on localhost:4566 (no Python needed).
#
#   copy floci_override.tf.example floci_override.tf
#
# Terraform merges *_override.tf files over the normal config, redirecting the
# AWS provider at LocalStack (localhost:4566). The copy is gitignored, so real
# AWS deployments are unaffected — just delete it (or rename back to .example)
# before running against real AWS. Then use plain terraform commands:
#
#   terraform init
#   terraform plan  -var-file=common.tfvars -var-file=floci.tfvars
#   terraform apply -var-file=common.tfvars -var-file=floci.tfvars
# ---------------------------------------------------------------------------

provider "aws" {
  access_key = "test"
  secret_key = "test"
  region     = "ap-southeast-1"

  s3_use_path_style           = true
  skip_credentials_validation = true
  skip_metadata_api_check     = true
  skip_requested_account_id   = true

  endpoints {
    acm                = "http://localhost:4566"
    autoscaling        = "http://localhost:4566"
    cloudtrail         = "http://localhost:4566"
    cloudwatch         = "http://localhost:4566"
    codebuild          = "http://localhost:4566"
    codedeploy         = "http://localhost:4566"
    codepipeline       = "http://localhost:4566"
    codestarconnections = "http://localhost:4566"
    cognitoidp         = "http://localhost:4566"
    ec2                = "http://localhost:4566"
    elbv2              = "http://localhost:4566"
    events             = "http://localhost:4566"
    guardduty          = "http://localhost:4566"
    iam                = "http://localhost:4566"
    inspector2         = "http://localhost:4566"
    kms                = "http://localhost:4566"
    logs               = "http://localhost:4566"
    rds                = "http://localhost:4566"
    route53            = "http://localhost:4566"
    s3                 = "http://localhost:4566"
    secretsmanager     = "http://localhost:4566"
    securityhub        = "http://localhost:4566"
    sns                = "http://localhost:4566"
    ssm                = "http://localhost:4566"
    sts                = "http://localhost:4566"
    wafv2              = "http://localhost:4566"
  }
}
